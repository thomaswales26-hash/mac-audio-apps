{
  "name": "open-passage",
  "productName": "Open Passage",
  "private": true,
  "version": "1.0.0",
  "description": "A macOS VPN Gate profile client for Tunnelblick and OpenVPN Connect.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port ${PORT:-3000} --hostname 0.0.0.0",
    "build": "NODE_OPTIONS=--no-deprecation payload build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "format": "oxfmt",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "desktop": "electron .",
    "prepare:desktop": "NODE_ENV=production pnpm build && node scripts/prepare-desktop.mjs",
    "package:mac": "pnpm package:mac:arm64",
    "package:mac:arm64": "pnpm prepare:desktop && node scripts/package-desktop.mjs arm64",
    "package:mac:x64": "pnpm prepare:desktop && node scripts/package-desktop.mjs x64"
  },
  "dependencies": {
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.7",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.7",
    "@payloadcms/plugin-mcp": "4.0.0-beta.7",
    "@payloadcms/richtext-lexical": "4.0.0-beta.7",
    "@payloadcms/translations": "4.0.0-beta.7",
    "@payloadcms/ui": "4.0.0-beta.7",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.2",
    "payload": "4.0.0-beta.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "electron",
      "unrs-resolver"
    ]
  }
}
